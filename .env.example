# NEWS ANALYZE API — copiar a .env (nunca subir secretos al repositorio)
APP_ENV=development

# MongoDB Atlas: la MISMA base que usa la app Next.js durante la transición
MONGODB_URI=
MONGODB_DB_NAME=news_analize
# Opcional: DNS para resolver mongodb+srv si el DNS del sistema no responde (fuera de Docker)
MONGODB_DNS_SERVERS=

# Compartidos con Next.js: deben ser IDÉNTICOS a los de newsAnalyze/.env.local
JWT_SECRET_KEY=
JWT_ISSUER=news-analize-api
JWT_AUDIENCE=news-analize-web
HMAC_AUDIT_SECRET=

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_GRACE_SECONDS=45

# Admin inicial (solo si la colección users está vacía)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Cookies Secure: true en cualquier entorno con HTTPS; false solo en http://localhost
COOKIE_SECURE=false
TRUST_PROXY_HEADERS=true

REDIS_URL=

# Documentos y cola de trabajos (Fase 2)
STORAGE_BACKEND=local
STORAGE_ROOT=./storage
DOCUMENTS_MAX_SIZE_MB=50
DOCUMENTS_MAX_PAGES=200
DEDUPE_WINDOW_DAYS=30
JOB_MAX_ATTEMPTS=3
JOB_LEASE_SECONDS=120
# Sin REDIS_URL los documentos quedan en cola (no se procesan) hasta que haya broker y worker.
# REDIS_URL=redis://localhost:6379/0

# Agente de ingesta por carpeta
INGEST_FOLDER=./storage/inbox
INGEST_POLL_SECONDS=60
INGEST_STABLE_SECONDS=30

# OCR para PDFs escaneados: tesseract (requiere el binario y el idioma spa; incluido en la imagen Docker) | none
OCR_ENGINE=tesseract
# TESSDATA_PREFIX=C:/Program Files/Tesseract-OCR/tessdata
